# Copy to .env.production and set secrets locally or through deployment secret management.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

LOG_LEVEL=INFO
PYROBOT_MODE=paper
PYROBOT_AUTO_START=true
PYROBOT_ALLOW_LIVE_TRADING=false
PYROBOT_SYMBOLS=MSFT,AAPL
PYROBOT_BARS=2000
PYROBOT_BALANCE=100000
PYROBOT_BAR_INTERVAL=1.0
PYROBOT_CONSOLE_PORT=8080
PYTHONUNBUFFERED=1