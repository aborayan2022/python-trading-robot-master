# ── Broker Credentials ──────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://127.0.0.1:8182/callback

IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ── Database ────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=trader
POSTGRES_PASSWORD=changeme

# ── Redis ───────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Application ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
PYROBOT_MODE=paper
PYROBOT_SYMBOLS=MSFT,AAPL
PYROBOT_BARS=2000
PYROBOT_BALANCE=100000
PYROBOT_BAR_INTERVAL=1.0
PYROBOT_CONSOLE_PORT=8080
PYROBOT_AUTO_START=true
PYROBOT_ALLOW_LIVE_TRADING=false
PYROBOT_AUDIT_PATH=data/audit/ledger.jsonl
PYTHONUNBUFFERED=1

# ── Grafana ─────────────────────────────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_change_in_production
