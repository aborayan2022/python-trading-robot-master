# ── Broker Credentials ──────────────────────────────────────────────
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

SCHWAB_CLIENT_ID=
SCHWAB_CLIENT_SECRET=
SCHWAB_REDIRECT_URI=https://127.0.0.1:8182/callback

IBKR_HOST=127.0.0.1
IBKR_PORT=7497
IBKR_CLIENT_ID=1

# ── Database ────────────────────────────────────────────────────────
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=trading
POSTGRES_USER=trader
POSTGRES_PASSWORD=changeme

# ── Redis ───────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ── Application ─────────────────────────────────────────────────────
LOG_LEVEL=INFO
PYROBOT_MODE=paper
PYROBOT_SYMBOLS=MSFT,AAPL
PYROBOT_BARS=2000
PYROBOT_BALANCE=100000
PYROBOT_BAR_INTERVAL=1.0
PYROBOT_CONSOLE_PORT=8080
PYROBOT_AUTO_START=true
PYROBOT_ALLOW_LIVE_TRADING=false
PYROBOT_AUDIT_PATH=data/audit/ledger.jsonl
PYTHONUNBUFFERED=1

# ── Multi-market ────────────────────────────────────────────────────
# Market / strategy / universe / data-dir switches consumed by the
# providers, strategies, backtests, paper sessions, and runtime loop.
#   PYROBOT_MARKET     US (default) | metals | crypto — DataProviderRegistry
#   PYROBOT_STRATEGY   registered strategy name used by the loop and by
#                      StrategyRegistry.create_from_env (default us_trend)
#   PYROBOT_UNIVERSE   comma-separated symbols override for backtests/sessions
#   PYROBOT_DATA_DIR   root that contains data/ (default .)
#   PYROBOT_METALS_YEARS / PYROBOT_CRYPTO_YEARS   history years (default 5)
PYROBOT_MARKET=US
# PYROBOT_STRATEGY=us_trend
# PYROBOT_UNIVERSE=GC=F,SI=F,GLD,SLV
# PYROBOT_DATA_DIR=.
# PYROBOT_METALS_YEARS=5
# PYROBOT_CRYPTO_YEARS=5

# ── Grafana ─────────────────────────────────────────────────────────
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin_change_in_production
