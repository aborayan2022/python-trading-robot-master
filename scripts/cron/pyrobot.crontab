# PyRobot scheduled jobs — installed 2026-09-07, extended 2026-09-10 (Wave 5)
# System timezone is Africa/Cairo (EEST, UTC+3); all times below are Cairo.
# Cron environment is minimal: every job cd's to the repo root and uses the
# absolute venv python so .env + data paths resolve from the repo.
# Paper sessions persist their PaperBroker state to data/paper_state/*.json so
# daily runs continue the virtual account instead of restarting at $100k.

# --- Weekly research session (item 2.4): every Saturday 10:00 ---
0 10 * * 6 cd /home/ahmed/worke/python-trading-robot-master && .venv/bin/python scripts/weekly_research.py >> data/cron/weekly_research.log 2>&1

# --- Daily paper sessions per market (Wave 5) ---
# US: weekday full session near close (~22:40 Cairo = 15:40 ET)
40 22 * * 1-5 cd /home/ahmed/worke/python-trading-robot-master && .venv/bin/python us_paper_session.py >> data/cron/us_paper_session.log 2>&1
# Metals: daily (COMEX ~23h, only Saturday closed). Wave-5 close-out order
# (consultant approval #2, 2026-09-11): metals_trend is slated for retirement
# (-57.5%, 99% MC ruin), so the session is MONITORING ONLY (--dry-run, no
# broker orders) until the Wave 6 walk-forward verdict. Keep running the two
# market sessions as a verification structure; do not execute a retired strategy.
30 22 * * 0,1-5 cd /home/ahmed/worke/python-trading-robot-master && .venv/bin/python metals_paper_session.py --dry-run >> data/cron/metals_paper_session.log 2>&1
# Crypto: daily, 24/7/365. RESEARCH-ONLY (+2.2%, MC ruin 0.0%); monitoring only
# (--dry-run) until Wave 6 walk-forward gates are met (approval #2 and #4a).
30 22 * * * cd /home/ahmed/worke/python-trading-robot-master && .venv/bin/python crypto_paper_session.py --dry-run >> data/cron/crypto_paper_session.log 2>&1

# --- One-off live paper sessions for Monday 2026-09-07 (item 3.3.2) ---
# Smoke at market open (~16:35 Cairo = 09:35 ET)
35 16 7 9 * cd /home/ahmed/worke/python-trading-robot-master && .venv/bin/python us_paper_session.py --smoke >> data/cron/us_paper_smoke_2026-09-07.log 2>&1
# Full session near close (~22:40 Cairo = 15:40 ET, inside the pre-close window)
40 22 7 9 * cd /home/ahmed/worke/python-trading-robot-master && .venv/bin/python us_paper_session.py >> data/cron/us_paper_session_2026-09-07.log 2>&1

# Remove the two date-qualified 2026-09-07 lines after the sessions have run.