# Copy to .env.development for local development. Keep credentials local.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_BASE_URL=https://paper-api.alpaca.markets

LOG_LEVEL=DEBUG
PYROBOT_MODE=paper
PYROBOT_AUTO_START=false
PYROBOT_ALLOW_LIVE_TRADING=false
PYROBOT_SYMBOLS=MSFT,AAPL
PYROBOT_BARS=2000
PYROBOT_BALANCE=100000
PYROBOT_BAR_INTERVAL=1.0
PYROBOT_CONSOLE_PORT=8080
PYTHONUNBUFFERED=1